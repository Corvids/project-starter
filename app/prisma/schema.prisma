generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id        Int      @id @default(autoincrement())
  body      String   @db.VarChar(280)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("notes")
}
